<mvc:View
  controllerName="tasjeel.portal.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt"
  xmlns:tj="tasjeel.portal.control"
  xmlns:core="sap.ui.core"
  displayBlock="true">
  <tnt:ToolPage id="toolPage" sideExpanded="{ui>/sideExpanded}">
    <tnt:header>
      <tnt:ToolHeader id="toolHeader">
        <Button id="sideToggle" icon="sap-icon://phosphor/sidebar-simple" type="Transparent"
          tooltip="{i18n>shell.toggleNav}" press=".onSideToggle" visible="{= ${ui>/area} === 'staff' }" class="sapUiHideOnPhone"/>
        <tj:Logo size="1.5rem"/>
        <Title text="{i18n>brand}" level="H1" class="tjBrand"/>
        <Text text="{i18n>brand.sub}" class="tjBrandSub sapUiHideOnPhone" visible="{= ${ui>/area} === 'staff' }"/>
        <HBox class="tjTopNav sapUiHideOnPhone" visible="{= ${ui>/area} === 'applicant' }" renderType="Bare">
          <Button text="{i18n>nav.overview}" type="Transparent" press=".onTopNav" class="tjTopNavItem">
            <customData><core:CustomData key="route" value="home" writeToDom="true"/></customData>
          </Button>
          <Button text="{i18n>nav.application}" type="Transparent" press=".onTopNav" class="tjTopNavItem">
            <customData><core:CustomData key="route" value="wizard" writeToDom="true"/></customData>
          </Button>
        </HBox>
        <ToolbarSpacer/>
        <Button icon="sap-icon://phosphor/globe-simple" text="{i18n>shell.language}" type="Transparent" press=".onToggleLanguage" class="tjLangBtn"/>
        <Button icon="{= ${ui>/theme} === 'dark' ? 'sap-icon://phosphor/sun' : 'sap-icon://phosphor/moon' }" type="Transparent"
          tooltip="{= ${ui>/theme} === 'dark' ? ${i18n>shell.themeLight} : ${i18n>shell.themeDark} }" press=".onToggleTheme"/>
        <Button icon="sap-icon://phosphor/bell" type="Transparent" tooltip="{i18n>shell.notifications}" visible="{= !!${ui>/user} }" class="sapUiHideOnPhone"/>
        <Avatar id="avatar" initials="{ui>/user/initials}" displaySize="XS" displayShape="Square" press=".onUserMenu"
          visible="{= !!${ui>/user} }" class="tjAvatar" ariaHasPopup="Menu"/>
      </tnt:ToolHeader>
    </tnt:header>
    <tnt:sideContent>
      <tnt:SideNavigation id="sideNav" itemSelect=".onSideSelect" selectedKey="{ui>/route}" ariaLabel="{i18n>brand}">
        <tnt:NavigationList>
          <tnt:NavigationListItem key="inbox" text="{i18n>nav.inbox}" icon="sap-icon://phosphor/tray"/>
          <tnt:NavigationListItem key="dashboard" text="{i18n>nav.dashboard}" icon="sap-icon://phosphor/chart-line-up"/>
          <tnt:NavigationListItem key="vendors" text="{i18n>nav.vendors}" icon="sap-icon://phosphor/buildings" href="{ui>/vendorsUrl}"/>
        </tnt:NavigationList>
        <tnt:fixedItem>
          <tnt:NavigationList>
            <tnt:NavigationListItem key="settings" text="{i18n>nav.settings}" icon="sap-icon://phosphor/gear-six"/>
          </tnt:NavigationList>
        </tnt:fixedItem>
      </tnt:SideNavigation>
    </tnt:sideContent>
    <tnt:mainContents>
      <NavContainer id="pages" class="tjPages" autoFocus="false"/>
      <tj:TabBar id="tabBar" selectedKey="{ui>/route}" select=".onTabSelect" visible="{= ${ui>/area} !== 'public' }">
        <tj:TabBarItem key="home" text="{i18n>nav.overview}" icon="sap-icon://phosphor/house" visible="{= ${ui>/area} === 'applicant' }"/>
        <tj:TabBarItem key="wizard" text="{i18n>nav.application}" icon="sap-icon://phosphor/file-text" visible="{= ${ui>/area} === 'applicant' }"/>
        <tj:TabBarItem key="inbox" text="{i18n>nav.inbox}" icon="sap-icon://phosphor/tray" count="{ui>/counts/inbox}" visible="{= ${ui>/area} === 'staff' }"/>
        <tj:TabBarItem key="dashboard" text="{i18n>nav.dashboard}" icon="sap-icon://phosphor/chart-line-up" visible="{= ${ui>/area} === 'staff' }"/>
        <tj:TabBarItem key="settings" text="{i18n>nav.settings}" icon="sap-icon://phosphor/gear-six"/>
      </tj:TabBar>
    </tnt:mainContents>
  </tnt:ToolPage>
</mvc:View>
